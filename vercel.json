{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/cursor-handler.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/cursor",
      "destination": "/api/cursor-handler"
    },
    {
      "source": "/api/cursor/(.*)",
      "destination": "/api/cursor-handler?path=$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
