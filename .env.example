# Cursor user API key from https://cursor.com/dashboard → Integrations → User API Keys
# Format: crsr_...
VITE_API_TOKEN=

# Local dev proxy to Cursor (recommended). Do not point the browser at OpenAI.
VITE_API_BASE_URL=/api/cursor

# Optional model id from Cursor (e.g. composer-2.5). Omit for your account default.
VITE_API_MODEL=
