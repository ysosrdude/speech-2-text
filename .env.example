# Cursor user API key from https://cursor.com/dashboard → Integrations → User API Keys
# Format: crsr_...
VITE_API_TOKEN=

# Local Vite proxy to Cursor (use this with npm run dev — do not use api.openai.com)
VITE_API_BASE_URL=/api/cursor

# Cursor Cloud Agents model id for Composer 2.5 (fast default: composer-2.5-fast)
VITE_API_MODEL=composer-2.5
