# --- Local development (npm run dev on your machine) ---
VITE_API_TOKEN=
VITE_API_BASE_URL=/api/cursor
VITE_API_MODEL=composer-2.5

# --- StackBlitz / browser-only hosts (no local proxy) ---
# 1) Deploy this repo to Vercel
# 2) Set CURSOR_API_KEY=crsr_... in Vercel project Environment Variables
# 3) Use your deployment URL (no VITE_API_TOKEN in StackBlitz):
# VITE_API_BASE_URL=https://your-project.vercel.app/api/cursor
# VITE_API_MODEL=composer-2.5
